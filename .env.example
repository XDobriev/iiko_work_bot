# Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Дополнительный каскад моделей через запятую (приоритет слева направо)
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash,gemini-2.5-flash

# Telegram Bot
TELEGRAM_TOKEN=
# Разрешенные ID пользователей через запятую (оставь пустым, чтобы разрешить всем)
ALLOWED_USER_IDS=

# iikoWeb API
IIKO_URL=https://beyni.iikoweb.ru
IIKO_LOGIN=
IIKO_PASSWORD=

# Путь к локальной SQLite базе данных
DATABASE_PATH=./data/invoices.db

# Telegram Mini App (Web App, опционально)
WEBAPP_ENABLED=false
WEBAPP_PORT=3000
# Внешний HTTPS URL для Telegram Mini App (ngrok, cloudflared, vercel или свой домен)
# Оставьте пустым, если запускаете только в локальной сети / через текстовый интерфейс
WEBAPP_URL=

# Amvera Cloud Deploy (РћРїС†РёРѕРЅР°Р»СЊРЅРѕ)
AMVERA_LOGIN=
AMVERA_USERNAME=
AMVERA_PASSWORD=
AMVERA_PROJECT=iiko-bot
AMVERA_GIT_URL=https://git.mia0.amvera.ru/khamzatd/iiko-bot
