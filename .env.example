# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash,gemini-3-flash-preview
GEMINI_MODELS_PHOTO=gemini-3.5-flash-lite,gemini-3.5-flash,gemini-3-flash-preview
GEMINI_MODELS_VOICE=gemini-3.5-transcribe,gemini-3.5-flash-lite,gemini-3.5-flash
GEMINI_MODELS_COMPLEX=gemini-3.5-flash,gemini-3-flash-preview,gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=120000
GEMINI_STALLED_TIMEOUT_MS=25000
GEMINI_PING_TIMEOUT_MS=35000

# Telegram Bot
TELEGRAM_TOKEN=
ALLOWED_USER_IDS=

# iikoWeb API
IIKO_URL=https://beyni.iikoweb.ru
IIKO_LOGIN=
IIKO_PASSWORD=

# SQLite Database
DATABASE_PATH=./data/invoices.db

# Telegram Mini App (WebApp)
WEBAPP_ENABLED=true
WEBAPP_PORT=3000
# Публичный HTTPS-адрес для работы сенсорного редактора и виджетов Telegram Mini App.
# В облаке Amvera: https://<проект>-<пользователь>.amvera.io
# При локальном запуске (на ПК): используйте туннель (npx localtunnel --port 3000 -> https://xxx.loca.lt)
WEBAPP_URL=
